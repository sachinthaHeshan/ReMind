<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Widget Title -->
    <TextView
        android:id="@+id/widget_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Today's Habits"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:textStyle="bold" />

    <!-- Progress Circle Container -->
    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp">

        <!-- Background Circle -->
        <ProgressBar
            android:id="@+id/progress_background"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:indeterminate="false"
            android:max="100"
            android:progress="100"
            android:progressDrawable="@drawable/circular_progress_background" />

        <!-- Actual Progress Circle -->
        <ProgressBar
            android:id="@+id/progress_circle"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:indeterminate="false"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/circular_progress" />

        <!-- Percentage Text in Center -->
        <TextView
            android:id="@+id/widget_percentage"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center"
            android:gravity="center"
            android:text="0%"
            android:textAlignment="center"
            android:textColor="@color/primary"
            android:textSize="32sp"
            android:textStyle="bold" />

    </FrameLayout>

    <!-- Habit Count Text -->
    <TextView
        android:id="@+id/widget_habit_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="0 of 0 completed"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <!-- Last Updated Time -->

</LinearLayout>

